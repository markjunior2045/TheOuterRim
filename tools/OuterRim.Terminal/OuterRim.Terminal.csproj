<Project Sdk="Microsoft.NET.Sdk">

  <!-- V0 (PLAN T3.1): seeded games between random bots in a terminal. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Off on purpose: core sources must carry their own usings to compile under Unity. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>OuterRim.Terminal</RootNamespace>
    <AssemblyName>outer-rim-v0</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The single copy of the core source, as in the test project. -->
    <Compile Include="..\..\src\OuterRim.Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
