<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the shared NUnit tests (tests/OuterRim.Core.SharedTests) under dotnet; Unity runs the same files (PLAN T0.4). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>OuterRim.Core.SharedTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\OuterRim.Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\OuterRim.Core.SharedTests\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- NUnit 3: Unity's Test Framework ships NUnit 3, whose classic asserts NUnit 4 removed. -->
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
